# ==================================================
# Student Task Manager - Environment Configuration
# ==================================================

# Backend Server Port
PORT=5000

# MongoDB Database Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/student-task-manager

# Secret Key for JWT Authentication Signatures
JWT_SECRET=your_jwt_secret_key_here

# Frontend API Base URL (optional in dev if using Vite proxy)
VITE_API_BASE_URL=http://localhost:5000/api
